+// LLVM 23's TargetParser has no feature-bitset or per-kind memory helpers.
+// SGPR counts follow IsaVersion, the same split LLVM 24
+// uses. Image, LDS, EU, wave, workgroup, and VGPR counts are the 10.1
+// published table: the 10.2 formulas need tablegen GPUInfo and feature bits
+// this clang does not expose, and changing only EUsPerCU would desync
+// MaxWavesPerCU. gfx13-generic is in clang 23 and not in that table; it
+// matches the gfx1310 / gfx12-generic row.
+struct IsaMetaRow {
+  bool Image;
+  unsigned LDS;
+  unsigned Banks;
+  unsigned EUs;
+  unsigned Waves;
+  unsigned WG;
+  unsigned VgprAlloc;
+  unsigned VgprTotal;
+  unsigned VgprAddr;
+};
+
+static bool sgprInitBug(StringRef Processor) {
+  return Processor == "gfx600" || Processor == "gfx601" ||
+         Processor == "gfx602";
+}
+
+static unsigned addressableNumSGPRs(StringRef Processor) {
+  // SI cannot initialize the upper SGPRs.
+  if (sgprInitBug(Processor))
+    return 96;
+  auto Version = AMDGPU::getIsaVersion(Processor);
+  if (Version.Major >= 10)
+    return 106;
+  if (Version.Major >= 8)
+    return 102;
+  return 104;
+}
+
+static unsigned sgprAllocGranule(StringRef Processor) {
+  auto Version = AMDGPU::getIsaVersion(Processor);
+  if (Version.Major >= 10)
+    return addressableNumSGPRs(Processor);
+  if (Version.Major >= 8)
+    return 16;
+  return 8;
+}
+
+static unsigned totalNumSGPRs(StringRef Processor) {
+  auto Version = AMDGPU::getIsaVersion(Processor);
+  return Version.Major >= 8 ? 800 : 512;
+}
