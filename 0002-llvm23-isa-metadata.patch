 const char *getIsaName(size_t Index) { return IsaInfos[Index].IsaName; }
 
+// LLVM 23 exposes these counts only through MCSubtargetInfo. The TargetParser
+// IsaVersion is enough to reproduce the same table.
+static bool sgprInitBug(StringRef Processor) {
+  return Processor == "gfx600" || Processor == "gfx601" ||
+         Processor == "gfx602";
+}
+
+static unsigned addressableNumSGPRs(StringRef Processor) {
+  // SI cannot initialize the upper SGPRs.
+  if (sgprInitBug(Processor))
+    return 96;
+  auto Version = AMDGPU::getIsaVersion(Processor);
+  if (Version.Major >= 10)
+    return 106;
+  if (Version.Major >= 8)
+    return 102;
+  return 104;
+}
+
+static unsigned sgprAllocGranule(StringRef Processor) {
+  auto Version = AMDGPU::getIsaVersion(Processor);
+  if (Version.Major >= 10)
+    return addressableNumSGPRs(Processor);
+  if (Version.Major >= 8)
+    return 16;
+  return 8;
+}
+
+static unsigned totalNumSGPRs(StringRef Processor) {
+  auto Version = AMDGPU::getIsaVersion(Processor);
+  return Version.Major >= 8 ? 800 : 512;
+}
